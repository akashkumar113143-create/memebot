<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Safe-install build: no INTERNET and no sensitive special-access services. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <application android:allowBackup="false" android:fullBackupContent="false" android:label="Jarvis Phone" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <receiver android:name=".ReminderReceiver" android:exported="false" />
    </application>
</manifest>
